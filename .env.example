# Copy this file to .env and replace every change-me value before starting.
# Docker Compose reads this file locally. Windows AWS helpers read only their
# explicit five-key allowlist at the bottom. Never commit .env.

COMPOSE_PROJECT_NAME=pz-server

# Project Zomboid identity and access
PZ_SERVER_NAME=pzserver
SERVER_PUBLIC_NAME=Friends Project Zomboid Build 42
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
SERVER_PASSWORD=change-me-server-password
RCON_PASSWORD=change-me-rcon-password
MAX_PLAYERS=16

# SteamCMD. An empty branch means the current stable branch (Build 42).
STEAM_APP_ID=380870
STEAM_BRANCH=
STEAM_BRANCH_PASSWORD=
UPDATE_ON_START=false
STEAM_VALIDATE=false

# Current Build 42 networking. RCON is published to host loopback only.
GAME_BIND_ADDRESS=0.0.0.0
GAME_PORT=16261
DIRECT_PORT=16262
RCON_PORT=27015

# JVM and local resource limits. Production bootstrap overrides these for 16 GiB.
PZ_XMS=2g
PZ_XMX=8g
CONTAINER_CPUS=2.0
CONTAINER_MEMORY_LIMIT=10g
PZ_UID=1000
PZ_GID=1000

# Persistent local paths. Everything below runtime/ is ignored by Git.
PZ_SERVER_PATH=./runtime/server
PZ_DATA_PATH=./runtime/zomboid

# Vanilla initially. Semicolon-separated IDs can be added later.
MODS=
WORKSHOP_ITEMS=
MAP_NAMES=Muldraugh, KY

# Container lifecycle
RESTART_POLICY=unless-stopped
SHUTDOWN_SAVE_SECONDS=15
SHUTDOWN_GRACE_SECONDS=90
STATISTICS_PERIOD=0
TZ=UTC

# Watchdog defaults. Local host shutdown is intentionally impossible by default.
IDLE_TIMEOUT_MINUTES=45
POLL_INTERVAL_SECONDS=60
RCON_RETRY_COUNT=3
RCON_RETRY_DELAY_SECONDS=5
RCON_TIMEOUT_SECONDS=10
HEALTH_FAILURE_TIMEOUT_MINUTES=12
FINAL_CHECK_COUNT=3
FINAL_CHECK_DELAY_SECONDS=5
SERVICE_STOP_TIMEOUT_SECONDS=120
DRY_RUN=true
DEPLOYMENT_ENVIRONMENT=local
HOST_SHUTDOWN_ENABLED=false
HOST_SHUTDOWN_GUARD_FILE=/etc/pz-server/allow-host-shutdown

# AWS helper defaults. Terraform has equivalent independently validated variables.
AWS_REGION=us-east-1
# Optional explicit overrides; normally Start-PZ reads these Terraform-managed tags from EC2.
# NORMAL_INSTANCE_TYPE=r7a.large
# PARTY_INSTANCE_TYPE=m7a.xlarge
PZ_PROJECT_TAG=pz-server
PZ_ENVIRONMENT_TAG=production
