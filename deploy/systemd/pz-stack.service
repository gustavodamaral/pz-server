[Unit]
Description=Project Zomboid Docker Compose stack
Documentation=https://github.com/gustavodamaral/pz-server
Requires=docker.service
After=docker.service network-online.target srv-pz.mount
Wants=network-online.target
RequiresMountsFor=/srv/pz

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/pz-stack
EnvironmentFile=/srv/pz/secrets.env
ExecStartPre=/usr/local/sbin/pz-resize-data-volume
ExecStartPre=/usr/bin/docker compose --project-directory /opt/pz-stack --file /opt/pz-stack/compose.yaml --env-file /srv/pz/secrets.env config --quiet
ExecStart=/usr/local/sbin/pz-start-stack
ExecStop=/usr/bin/docker compose --project-directory /opt/pz-stack --file /opt/pz-stack/compose.yaml --env-file /srv/pz/secrets.env stop --timeout 120 server
TimeoutStartSec=70min
TimeoutStopSec=3min
UMask=0077
ExecCondition=/usr/local/sbin/pz-deployment-unit-guard

[Install]
WantedBy=multi-user.target
